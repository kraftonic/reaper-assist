{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@ai/*": [
        "./src/ai/*"
      ],
      "@daw/*": [
        "./src/daw/*"
      ],
      "@profiles": [
        "./src/profiles/index.ts"
      ],
      "@profiles/*": [
        "./src/profiles/*"
      ],
      "@shared/*": [
        "./src/shared/*"
      ],
      "@studio/*": [
        "./src/studio/*"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "test",
    "aliases.mts",
    "electron.vite.config.ts",
    "vitest.config.mts",
    "vitest.reaper.config.mts"
  ]
}
